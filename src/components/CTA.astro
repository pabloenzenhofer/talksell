---
const {
  title = '¿Qué proceso te está haciendo perder tiempo?',
  text = 'Agendá tu mapeo de procesos y detectemos juntos las oportunidades de automatización de tu empresa',
  buttonLabel = 'Agendar tu mapeo',
  href = 'https://calendar.app.google/nxdsWCTvyX6Fj58eA'
} = Astro.props;
---
<section class="section cta-section" id="mapeo">
  <div class="container">
    <div class="cta-panel">
      <div>
        <p class="eyebrow">Mapeo de oportunidades</p>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <a class="button" href={href} target="_blank" rel="noopener">{buttonLabel} <span>↗</span></a>
    </div>
  </div>
</section>
